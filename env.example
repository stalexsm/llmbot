# Токен бота от @BotFather (обязательная переменная)
TELEGRAM_BOT_TOKEN=

# Локальный Ollama: адрес и модель
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen3:4b

# Режим размышлений модели (think). Для reasoning-моделей вроде qwen3
# включи true: без него они могут молча выдавать пустой ответ на
# многошаговых инструментальных задачах. Моделям без поддержки thinking — false.
OLLAMA_THINK=true

# Окно контекста на запрос (num_ctx): перекрывает дефолт сервера Ollama
# (4096) независимо от способа его запуска. Больше окно — больше памяти
# под KV-кэш.
OLLAMA_NUM_CTX=8192

# --- Агентный цикл ---

# Лимит шагов: один шаг = один ответ модели. При исчерпании
# пользователь получает честное сообщение об остановке.
AGENT_MAX_STEPS=10

# Таймаут одной команды инструмента exec, секунд; зависшая команда
# обрывается вместе с группой её процессов.
AGENT_EXEC_TIMEOUT_SECONDS=60

# Вывод команды (exit code + stdout + stderr) чистится от ANSI-кодов и
# прогресс-шума, затем обрезается до этого числа символов (сохраняются
# голова и хвост, середина схлопывается маркером), прежде чем попасть модели.
AGENT_EXEC_MAX_OUTPUT_CHARS=4000

# --- Чат-сессии и скиллы ---

# Окно истории чат-сессии: сколько последних сообщений уходит в запрос.
AGENT_HISTORY_MAX_MESSAGES=20

# Компакция старших tool-выводов в агентном цикле: выводы инструментов
# шагов старше последних K схлопываются в сигнатуру «команда → ok/ошибка»
# (модель может перечитать вывод повторной командой). Записанная чат-сессия
# не меняется. 0 — выключено.
AGENT_COMPACTION_KEEP_STEPS=3

# --- Учёт токенов ---

# Цены input/output за 1M токенов (в валюте учёта) для оценки стоимости
# в метриках (.data/metrics/events.jsonl); по умолчанию 0 — стоимость нулевая.
METRICS_INPUT_PRICE_PER_MTOK=0
METRICS_OUTPUT_PRICE_PER_MTOK=0

# Каталог скиллов (раскладка skills/<имя>/SKILL.md); индекс собирается
# при каждом старте бота.
AGENT_SKILLS_DIRECTORY=skills

# --- RAG: документы и поиск ---

# Модель эмбеддингов Ollama (скачивается отдельно: ollama pull bge-m3)
# и её таймаут, секунд.
OLLAMA_EMBED_MODEL=bge-m3
OLLAMA_EMBED_TIMEOUT_SECONDS=120

# Чанкинг: целевой размер чанка и overlap между соседними чанками, символов.
# Overlap должен быть меньше целевого размера.
RAG_CHUNK_TARGET_CHARS=900
RAG_CHUNK_OVERLAP_CHARS=150

# Поиск: сколько чанков возвращается (top-K), во сколько раз шире внутренний
# переопрос перед фильтром по владельцу и минимальная косинусная близость —
# ниже порога поиск отвечает «ничего не найдено». Порог откалиброван на
# evaluation-датасете (uv run python -m bot.evaluation): худшее попадание
# 0.578, лучшее ложное срабатывание 0.437.
RAG_SEARCH_TOP_K=5
RAG_SEARCH_OVERFETCH=4
RAG_MIN_SIMILARITY=0.5

# Лимиты индексации: файл ≤ 20 MB, извлечённый текст ≤ 200k символов,
# не больше 300 чанков на документ.
RAG_MAX_FILE_BYTES=20971520
RAG_MAX_TEXT_CHARS=200000
RAG_MAX_CHUNKS=300

# --- Безопасность ---

# Allowlist чатов через запятую (пусто — бот отвечает всем чатам,
# заполнен — сообщения из чужих чатов молча игнорируются).
TELEGRAM_ALLOWED_CHAT_IDS=

# --- Живые тесты (uv run pytest -m live) ---

# Модель-судья живых тестов качества (LLM-as-a-Judge): судит свободные
# ответы по вежливости, точности и лаконичности. Пусто — судит та же
# модель, что пишет ответы (OLLAMA_MODEL).
OLLAMA_JUDGE_MODEL=

# SLA живого теста задержки: полный ответ модели должен уложиться в это
# число секунд. Подстрой под своё железо.
OLLAMA_LATENCY_SECONDS=4

# --- Сеть и логирование ---

# Таймауты запросов к Ollama и Telegram API, секунд.
OLLAMA_TIMEOUT_SECONDS=120
TELEGRAM_TIMEOUT_SECONDS=30

# Уровень и формат логов (console или json).
LOG_LEVEL=INFO
LOG_FORMAT=console
