# Токен бота от @BotFather (обязательная переменная)
TELEGRAM_BOT_TOKEN=

# Локальный Ollama: адрес и модель
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen3:1.7b

# Режим размышлений модели (think). Для reasoning-моделей вроде qwen3
# включи true: без него они могут молча выдавать пустой ответ на
# многошаговых инструментальных задачах. Моделям без поддержки thinking — false.
OLLAMA_THINK=true

# --- Агентный цикл ---

# Лимит шагов: один шаг = один ответ модели. При исчерпании
# пользователь получает честное сообщение об остановке.
AGENT_MAX_STEPS=10

# Таймаут одной команды инструмента exec, секунд; зависшая команда
# обрывается вместе с группой её процессов.
AGENT_EXEC_TIMEOUT_SECONDS=60

# Вывод команды (exit code + stdout + stderr) чистится от ANSI-кодов и
# прогресс-шума, затем обрезается до этого числа символов (сохраняются
# голова и хвост, середина схлопывается маркером), прежде чем попасть модели.
AGENT_EXEC_MAX_OUTPUT_CHARS=4000

# --- Чат-сессии и скиллы ---

# Окно истории чат-сессии: сколько последних сообщений уходит в запрос.
AGENT_HISTORY_MAX_MESSAGES=20

# --- Учёт токенов ---

# Цены input/output за 1M токенов (в валюте учёта) для оценки стоимости
# в метриках (.data/metrics/events.jsonl); по умолчанию 0 — стоимость нулевая.
METRICS_INPUT_PRICE_PER_MTOK=0
METRICS_OUTPUT_PRICE_PER_MTOK=0

# Каталог скиллов (раскладка skills/<имя>/SKILL.md); индекс собирается
# при каждом старте бота.
AGENT_SKILLS_DIRECTORY=skills

# --- Безопасность ---

# Allowlist чатов через запятую (пусто — бот отвечает всем чатам,
# заполнен — сообщения из чужих чатов молча игнорируются).
TELEGRAM_ALLOWED_CHAT_IDS=

# --- Сеть и логирование ---

# Таймауты запросов к Ollama и Telegram API, секунд.
OLLAMA_TIMEOUT_SECONDS=120
TELEGRAM_TIMEOUT_SECONDS=30

# Уровень и формат логов (console или json).
LOG_LEVEL=INFO
LOG_FORMAT=console
